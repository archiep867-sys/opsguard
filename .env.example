# Copy to .env or export these in your shell. Never put real credentials in this file.

# Local Strands Decider server (strands-decider serve <checkpoint> --port 8099)
STRANDS_DECIDER_URL=http://127.0.0.1:8099
STRANDS_DECIDER_TIMEOUT=20

# Decider policy knobs
OPSGUARD_MODEL_ASSISTED_UNKNOWN=true
OPSGUARD_MIN_MODEL_CONFIDENCE=0.5

# Optional Amazon Bedrock explanations and agent (off by default)
OPSGUARD_BEDROCK_ENABLED=false
OPSGUARD_BEDROCK_MODEL_ID=us.amazon.nova-micro-v1:0
AWS_REGION=us-east-1

# Where the audit database lives (default: ./opsguard_audit.sqlite3)
# OPSGUARD_DB_PATH=/path/to/audit.sqlite3
